# ==============================================================================
# CivicLoop — Local Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting local services:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit real credentials or active '.env' files to version control.
# - The active '.env' file is strictly ignored by Git (.gitignore).
# ==============================================================================

# PostgreSQL Container Configuration (Docker Compose)
POSTGRES_USER=civicloop_user
POSTGRES_PASSWORD=civicloop_dev_password_change_me
POSTGRES_DB=civicloop_dev
POSTGRES_PORT=5432

# Database Connection URL (for local development and future Prisma ORM integration)
DATABASE_URL=postgresql://civicloop_user:civicloop_dev_password_change_me@127.0.0.1:5432/civicloop_dev?schema=public
